.mypy_cache/
.pytype/
.ruff_cache/

# C++
*.o
*.obj
*.a
*.lib
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
Makefile
