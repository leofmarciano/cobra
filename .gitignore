# Transient loop-harness state files.
scripts/.cobra_loop.pid
scripts/.cobra_loop_status.json
scripts/.cobra_loop_logs/
nop.gitignore

# Build outputs and generated artifacts
/build/
/cmake-build-*/
out/

# Third-party and vendored dependencies
/third_party/
/vendor/

# Cobra-specific cache and raw artifacts
/.cobra/cache/
/artifacts/raw/

